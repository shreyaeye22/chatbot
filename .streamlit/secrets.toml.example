# Copy this file to .streamlit/secrets.toml and fill in real values.
# .streamlit/secrets.toml is gitignored - never commit real secrets.

# Which model provider to use: "anthropic" (default) or "huggingface" (free fallback).
LLM_PROVIDER = "anthropic"

# Anthropic key - required when LLM_PROVIDER = "anthropic" (the default).
# Prompt caching (system instructions + tool definitions) is automatically enabled
# for this provider - see ARCHITECTURE.md.
ANTHROPIC_API_KEY = "sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
ANTHROPIC_MODEL_NAME = "claude-sonnet-5"

# Hugging Face Inference Providers token - free, create one at
# https://huggingface.co/settings/tokens (read access is enough).
# Only read/needed when LLM_PROVIDER = "huggingface" - a no-cost fallback for
# local development if you don't have an Anthropic key yet. No prompt caching
# support on this path.
HF_TOKEN = "hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
HF_MODEL_NAME = "meta-llama/Llama-3.2-3B-Instruct"

# Optional: console log level for agent/tool diagnostics (DEBUG, INFO, WARNING, ...).
LOG_LEVEL = "INFO"
